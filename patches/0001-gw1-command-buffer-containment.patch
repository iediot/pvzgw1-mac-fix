+  void DxvkContext::gw1TraceEnd(bool suspend) {
+    if (!m_gw1TraceFile.is_open()) return;
+    if (suspend && m_gw1TraceDraws) ++m_gw1TraceSplits;
+    bool expired=::GetTickCount64()-m_gw1TraceStart>=2000;
+    if ((!suspend || expired) && m_gw1TraceDraws) {
+      m_gw1TraceFile << "pass=" << m_gw1TraceRows++ << " draws=" << m_gw1TraceDraws
+        << " suspends=" << m_gw1TraceSplits << " " << m_gw1TraceAttachments
+        << " firstFS=" << m_gw1TraceFirstFs << " lastFS=" << m_gw1TraceLastFs << "\n";
+      m_gw1TraceDraws=m_gw1TraceSplits=0;
+    }
+    if (expired || m_gw1TraceRows>=256) {
+      m_gw1TraceFile << "complete rows=" << m_gw1TraceRows << " elapsedMs=" << ::GetTickCount64()-m_gw1TraceStart << "\n";
+      m_gw1TraceFile.close();
+    }
+  }
