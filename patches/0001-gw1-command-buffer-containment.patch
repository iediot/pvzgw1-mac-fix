+  void DxvkContext::gw1EndFrame() {
+    static const bool logFrames = std::getenv("DXVK_LOG_FRAMES") != nullptr;
+    static uint32_t n = 0;
+
+    if (logFrames && !(n++ & 31))
+      Logger::warn(str::format("GW1FRAME draws=", m_gw1DrawsInFrame, " flushes=", m_gw1Flushes));
+
+    // Hysteresis on the frame-weight gate. A single sparse camera angle can dip
+    // a match frame below the threshold; without hysteresis the next frame
+    // loses splitting entirely and dies whole, which looks like angle-dependent
+    // flicker. Turn splitting on immediately when a heavy frame appears, but
+    // only turn it off after a sustained run of light frames (a real return to
+    // a menu or loading screen).
+    static const uint32_t frameMinHys = [] {
+      const char* e = std::getenv("DXVK_SPLIT_FRAME_MIN");
+      return e ? uint32_t(std::atoi(e)) : 0u;
+    }();
+    static const uint32_t offAfter = [] {
+      const char* e = std::getenv("DXVK_SPLIT_OFF_AFTER");
+      return e ? uint32_t(std::atoi(e)) : 30u;
+    }();
+
+    if (m_gw1DrawsInFrame >= frameMinHys) {
+      m_gw1SplitActive = true;
+      m_gw1LightStreak = 0;
+    } else if (++m_gw1LightStreak >= offAfter) {
+      m_gw1SplitActive = false;
+    }
+
+    m_gw1PassIndex      = 0;
+    m_gw1Flushes        = 0;
+    m_gw1LastFrameDraws = m_gw1DrawsInFrame;
+    m_gw1DrawsInFrame   = 0;
+  }
