+  void DxvkContext::gw1ConsiderSplit() {
+    // Bounded pass capture disabled for this performance trial.
+    static const uint32_t threshold = [] {
+      const char* e = std::getenv("DXVK_SPLIT_DRAWS");
+      return e ? uint32_t(std::atoi(e)) : 0u;
+    }();
+
+    static const bool logDraws = std::getenv("DXVK_LOG_DRAWS") != nullptr;
+
+    if (logDraws) {
+      // Name the shaders this draw used, so a GPU fault reported right after
+      // the submit can be attributed to it. Only meaningful together with
+      // DXVK_SPLIT_DRAWS=1 and MVK_CONFIG_SYNCHRONOUS_QUEUE_SUBMITS=1, which
+      // make submission order and fault order line up.
+      // Straight to stderr, not Logger: MoltenVK's GPU faults go to stderr, and
+      // the two streams have to interleave for a fault to be attributable to
+      // the draw that preceded it. Logger writes to a separate file.
+      // WriteFile on STD_ERROR_HANDLE, not C stderr: under Wine the std handle
+      // is the same unix fd MoltenVK writes its GPU faults to, so the two
+      // interleave. The CRT's stderr is a different stream and never appears.
+      std::string line = str::format("GW1DRAW fs=",
+        m_state.gp.shaders.fs != nullptr ? m_state.gp.shaders.fs->debugName() : "none",
+        " vs=",
+        m_state.gp.shaders.vs != nullptr ? m_state.gp.shaders.vs->debugName() : "none",
+        "\n");
+      DWORD written = 0;
+      ::WriteFile(::GetStdHandle(STD_ERROR_HANDLE),
+        line.data(), DWORD(line.size()), &written, nullptr);
+    }
+
+    if (!threshold)
+      return;
+
+    // Do NOT flush here. Flushing mid-render-pass forces a suspend/resume of
+    // the framebuffer around every split, which shows up on screen as
+    // flickering. Just mark a split as wanted; spillRenderPass() performs it at
+    // the next natural pass boundary, where the attachments are being ended
+    // anyway and nothing extra is stored or reloaded.
+    // Splitting mid-pass suspends/resumes the framebuffer around each split,
+    // which flickers; splitting only at pass boundaries avoids that but cannot
+    // break up a single long pass. Mid-pass is the default because it is the
+    // configuration measured to actually render.
+    static const bool atPass = std::getenv("DXVK_SPLIT_AT_PASS") != nullptr;
+
+    // Never split a small render pass. Loading screens and menus draw only a
+    // handful of primitives per pass; splitting one of those in half forces a
+    // framebuffer suspend/resume that loses the pass contents, which shows up
+    // as dead/black frames. In-match passes are large and are exactly the ones
+    // that need splitting. DXVK_SPLIT_PASS_MIN is the number of draws a pass
+    // must already have before it is eligible to be split at all.
+    static const uint32_t passMin = [] {
+      const char* e = std::getenv("DXVK_SPLIT_PASS_MIN");
+      return e ? uint32_t(std::atoi(e)) : 0u;
+    }();
+
+    // Frame-weight gate. A menu or loading screen frame is a few hundred draws;
+    // a match frame is thousands. Splitting is only ever needed in the heavy
+    // frames, and it is precisely what breaks the light ones (lost pass
+    // contents -> missing menu elements, flickering loading screens). Attachment
+    // format cannot separate the two: the menu renders to the same HDR+depth
+    // targets gameplay does. Frame weight can.
+    //
+    // The current frame's count is still incomplete this early, so the previous
+    // frame is used as the predictor; consecutive frames are near-identical in
+    // weight, and a one-frame lag at a scene transition is harmless.
+    static const uint32_t frameMin = [] {
+      const char* e = std::getenv("DXVK_SPLIT_FRAME_MIN");
+      return e ? uint32_t(std::atoi(e)) : 0u;
+    }();
+
+    ++m_gw1DrawsInFrame;
+
+    if (frameMin && m_gw1LastFrameDraws < frameMin)
+      return;
+
+    // Splitting every pass costs a full attachment store+reload per split, which
+    // on a tile GPU saturates memory bandwidth. Only a few passes actually
+    // contain draws that fail, so restrict splitting to a range of pass indices
+    // and bisect to find them: DXVK_SPLIT_PASS_LO <= index < DXVK_SPLIT_PASS_HI.
+    // Unset HI means no upper bound.
+    static const uint32_t passLo = [] {
+      const char* e = std::getenv("DXVK_SPLIT_PASS_LO");
+      return e ? uint32_t(std::atoi(e)) : 0u;
+    }();
+    static const uint32_t passHi = [] {
+      const char* e = std::getenv("DXVK_SPLIT_PASS_HI");
+      return e ? uint32_t(std::atoi(e)) : ~0u;
+    }();
+
+    if (m_gw1PassIndex < passLo || m_gw1PassIndex >= passHi)
+      return;
+
+    // Bisect by position within the frame. Splitting every draw costs a full
+    // attachment store+reload each time, which saturates tile-GPU bandwidth;
+    // only some draws actually need it. Restrict splitting to
+    // DXVK_SPLIT_DRAW_LO <= drawIndex < DXVK_SPLIT_DRAW_HI and halve the range
+    // until the smallest window that still renders coherently is found.
+    static const uint32_t drawLo = [] {
+      const char* e = std::getenv("DXVK_SPLIT_DRAW_LO");
+      return e ? uint32_t(std::atoi(e)) : 0u;
+    }();
+    static const uint32_t drawHi = [] {
+      const char* e = std::getenv("DXVK_SPLIT_DRAW_HI");
+      return e ? uint32_t(std::atoi(e)) : ~0u;
+    }();
+
+    if (m_gw1DrawsInFrame < drawLo || m_gw1DrawsInFrame >= drawHi)
+      return;
+
+    // Splitting does not prevent the GPU fault -- it CONTAINS it. A failed
+    // command buffer loses only the draws it holds, so one buffer per frame
+    // loses the whole frame (black screen) while one buffer per draw loses only
+    // the draws that actually fail. That is why the fault count never reaches
+    // zero however finely we split, and why the picture keeps improving anyway.
+    //
+    // If containment is the mechanism, splitting after every draw is massive
+    // overkill: the failing draws just need to be isolated from the good ones.
+    // Draws sharing a pipeline succeed or fail together, so a shader change is
+    // a natural containment boundary -- and there are ~40-60 of those per frame
+    // instead of ~870 draws, which is a >10x cut in attachment store/reload
+    // traffic for the same isolation.
+    static const bool onShader = std::getenv("DXVK_SPLIT_ON_SHADER") != nullptr;
+
+    if (onShader) {
+      ++m_gw1DrawsSinceFlush;
+      const void* fs = m_state.gp.shaders.fs.ptr();
+
+      if (fs == m_gw1LastFs)
+        return;
+
+      m_gw1LastFs = fs;
+      m_gw1Flushes++;
+
+      // Only isolate shaders in [DXVK_SPLIT_FS_LO, DXVK_SPLIT_FS_HI). Most
+      // shaders never fail, so isolating them buys nothing and costs a full
+      // attachment store+reload each time. Bisect to the few that matter.
+      static const uint32_t fsLo = [] {
+        const char* e = std::getenv("DXVK_SPLIT_FS_LO");
+        return e ? uint32_t(std::atoi(e)) : 0u;
+      }();
+      static const uint32_t fsHi = [] {
+        const char* e = std::getenv("DXVK_SPLIT_FS_HI");
+        return e ? uint32_t(std::atoi(e)) : ~0u;
+      }();
+
+      if (fsLo || fsHi != ~0u) {
+        uint32_t id = gw1FsId();
+
+        if (id < fsLo || id >= fsHi)
+          return;
+      }
+
+      // Don't split on a shader change that is only a draw or two after the
+      // last split -- the containment gained is negligible and each split still
+      // costs a full attachment store+reload. Requiring a minimum batch keeps
+      // the boundaries shader-aligned while cutting the split count.
+      static const uint32_t minBatch = [] {
+        const char* e = std::getenv("DXVK_SPLIT_MIN_BATCH");
+        return e ? uint32_t(std::atoi(e)) : 0u;
+      }();
+
+      if (m_gw1DrawsSinceFlush < minBatch)
+        return;
+
+      m_gw1DrawsSinceFlush = 0;
+      this->flushCommandList();
+      return;
+    }
+
+    // GW1 trial: attachment signatures observed in gameplay, absent from the
+    // captured menu. These are candidates, not attributed GPU-fault signatures.
+    const auto& targets = m_state.om.framebufferInfo;
+    const bool hasDepth = targets.getDepthTarget().view != nullptr;
+    uint32_t colorCount = 0;
+    bool hdrDepth = false, maskDepth = false, wideFloat = false;
+    for (uint32_t i = 0; i < MaxNumRenderTargets; i++) {
+      const auto& color = targets.getColorTarget(i);
+      if (color.view == nullptr) continue;
+      ++colorCount;
+      const auto format = color.view->info().format;
+      const auto extent = color.view->image()->info().extent;
+      hdrDepth |= hasDepth && format == VK_FORMAT_R16G16B16A16_SFLOAT;
+      maskDepth |= hasDepth && format == VK_FORMAT_R8_UNORM;
+      wideFloat |= format == VK_FORMAT_R32G32B32A32_SFLOAT
+        && extent.height == 1 && extent.width >= 1024;
+    }
+    const bool forceSplit = hdrDepth || maskDepth || wideFloat
+      || (hasDepth && (colorCount == 0 || colorCount == 2));
+    ++m_gw1DrawsInPass;
+
+    // PASS_MIN exempted small passes from splitting. That is backwards: the
+    // draws that fail live in SMALL passes (lighting, effects) -- PASS_MIN=0
+    // renders correctly and PASS_MIN=10 leaves lighting detached, so the
+    // culprits are inside the first few draws of a pass. Splitting those is
+    // cheap precisely because there are few of them.
+    //
+    // So: split after every draw for the first DXVK_SPLIT_EARLY draws of a
+    // pass, then fall back to every DXVK_SPLIT_DRAWS draws. Small passes are
+    // fully covered; large passes pay the aggressive rate only at the start.
+    static const uint32_t earlyDraws = [] {
+      const char* e = std::getenv("DXVK_SPLIT_EARLY");
+      return e ? uint32_t(std::atoi(e)) : 0u;
+    }();
+
+    if (!forceSplit && passMin && m_gw1DrawsInPass <= passMin)
+      return;
+
+    uint32_t splitThreshold = threshold;
+
+    if (earlyDraws && m_gw1DrawsInPass <= earlyDraws)
+      splitThreshold = 1;
+    else if (hasDepth && colorCount == 0)
+      splitThreshold = std::max(threshold, 4u);   // amortize shadow submits
+    if (++m_gw1DrawsSinceFlush >= splitThreshold) {
+      m_gw1DrawsSinceFlush = 0;
+
+      if (atPass)
+        m_gw1WantFlush = true;
+      else
+        this->flushCommandList();
+    }
+  }
   
   
