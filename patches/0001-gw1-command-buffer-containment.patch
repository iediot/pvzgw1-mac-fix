+  // Drop draws whose fragment shader falls in [DXVK_SKIP_FS_LO, DXVK_SKIP_FS_HI).
+  // Bisecting with this finds the shader responsible for the residual flicker:
+  // splitting can only contain those failures, never prevent them, so the only
+  // way to make them stop is to not issue them.
+  bool DxvkContext::gw1SkipDraw() {
+    static const uint32_t lo = [] {
+      const char* e = std::getenv("DXVK_SKIP_FS_LO");
+      return e ? uint32_t(std::atoi(e)) : ~0u;
+    }();
+    static const uint32_t hi = [] {
+      const char* e = std::getenv("DXVK_SKIP_FS_HI");
+      return e ? uint32_t(std::atoi(e)) : 0u;
+    }();
+
+    if (lo == ~0u)
+      return false;
+
+    uint32_t id = gw1FsId();
+    return id >= lo && id < hi;
+  }
