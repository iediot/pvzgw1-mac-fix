+  uint32_t DxvkContext::gw1FsId() {
+    const void* fs = m_state.gp.shaders.fs.ptr();
+    auto it = m_gw1FsIds.find(fs);
+
+    if (it != m_gw1FsIds.end())
+      return it->second;
+
+    uint32_t id = uint32_t(m_gw1FsIds.size());
+    m_gw1FsIds.insert({ fs, id });
+
+    Logger::warn(str::format("GW1FS id=", id, " fs=",
+      m_state.gp.shaders.fs != nullptr
+        ? m_state.gp.shaders.fs->debugName() : "none"));
+    return id;
+  }
