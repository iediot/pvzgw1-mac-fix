+  void DxvkContext::gw1TraceDraw() {
+    if (!m_gw1TraceFile.is_open()) {
+      if ((++m_gw1TracePoll & 255) != 0) return;
+      // Presenter/HUD contexts have unkeyed shaders; capture game contexts only.
+      if (m_state.gp.shaders.fs == nullptr) return;
+      const auto shaderName=m_state.gp.shaders.fs->debugName();
+      if (shaderName.find("da39a3ee5e6b4b0d3255bfef95601890afd80709") != std::string::npos) return;
+      const char* labels[] = { "menu", "match" };
+      for (const char* label : labels) {
+        const auto trigger = str::format("C:/gw1diag/pass-", label, ".flag");
+        if (::GetFileAttributesA(trigger.c_str()) == INVALID_FILE_ATTRIBUTES) continue;
+        ::DeleteFileA(trigger.c_str());
+        m_gw1TraceFile.open(str::format("C:/gw1diag/pass-", label, ".txt"), std::ios::trunc);
+        if (!m_gw1TraceFile.is_open()) return;
+        m_gw1TraceFile << "pass-trace-v2 attachment-change groups; first/last group may be partial; formats/layouts are Vulkan enums\n";
+        m_gw1TraceStart = ::GetTickCount64();
+        m_gw1TraceRows = m_gw1TraceDraws = m_gw1TraceSplits = 0;
+        break;
+      }
+      if (!m_gw1TraceFile.is_open()) return;
+    }
+    const auto& currentFb=m_state.om.framebufferInfo;
+    std::string attachmentKey;
+    for (uint32_t i=0;i<currentFb.numAttachments();i++) {
+      const auto& a=currentFb.getAttachment(i);
+      attachmentKey += str::format(currentFb.getColorAttachmentIndex(i), ":", a.view.ptr(), ";");
+    }
+    if (m_gw1TraceDraws && attachmentKey != m_gw1TraceKey) {
+      this->gw1TraceEnd(false);
+      if (!m_gw1TraceFile.is_open()) return;
+    }
+    m_gw1TraceKey=attachmentKey;
+    if (!m_gw1TraceDraws) {
+      const auto& fb = m_state.om.framebufferInfo;
+      auto size = fb.size();
+      m_gw1TraceAttachments = str::format("fb=",size.width,"x",size.height,
+        " attachments=",fb.numAttachments()," depth=",fb.getDepthTarget().view != nullptr);
+      for (uint32_t i=0;i<fb.numAttachments();i++) {
+        const auto& a=fb.getAttachment(i);
+        if (a.view == nullptr) continue;
+        const auto& im=a.view->image()->info();
+        const auto& vi=a.view->info();
+        m_gw1TraceAttachments += str::format(" [slot=",fb.getColorAttachmentIndex(i),
+          " image=",a.view->image().ptr()," fmt=",vi.format," size=",im.extent.width,"x",im.extent.height,
+          " mip=",vi.minLevel," layer=",vi.minLayer," layers=",vi.numLayers,
+          " samples=",im.sampleCount," usage=",im.usage," commonLayout=",im.layout,
+          " boundLayout=",a.layout,
+          " presentLayout=",im.layout==VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+          "]");
+      }
+      m_gw1TraceFirstFs=m_state.gp.shaders.fs != nullptr ? m_state.gp.shaders.fs->debugName() : "none";
+    }
+    ++m_gw1TraceDraws;
+    m_gw1TraceLastFs=m_state.gp.shaders.fs != nullptr ? m_state.gp.shaders.fs->debugName() : "none";
+  }
